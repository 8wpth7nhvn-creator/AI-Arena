# Copy to .env to play against real AI. Without a key the game runs in demo mode.
ANTHROPIC_API_KEY=
# Optional overrides
# ARENA_MODEL=claude-opus-5
# ARENA_EVAL_EFFORT=medium      # grading depth: low | medium | high
# ARENA_VOICE_EFFORT=low        # character dialogue
# ARENA_FALLBACKS=off           # disable server-side refusal fallbacks
# AI_MODE=demo                  # force demo mode even with a key
# PORT=3000
